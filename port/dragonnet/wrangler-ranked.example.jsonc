{
  "name": "dbt-nx-matchmaking",
  "main": "worker.js",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "vars": {
    "REQUIRE_KEY": "off",
    "MIN_RELEASE": "0",
    "ALLOWED_VERSIONS": "40001,5001",
    "RANKED_ENABLED": "1",
    "CHAT_ENABLED": "1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dbt-nx-rooms",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ]
}
