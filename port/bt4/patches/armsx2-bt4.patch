diff --git a/pcsx2/GSDumpReplayer.h b/pcsx2/GSDumpReplayer.h
index 88c29b43f0..9aeab8c817 100644
--- a/pcsx2/GSDumpReplayer.h
+++ b/pcsx2/GSDumpReplayer.h
@@ -47,4 +47,20 @@ namespace GSDumpReplayer
 	void SetInitialStateHook(InitialStateHook hook);
 
 	void RenderUI();
+
+	/// Live mode (Dragon Rage, Budokai Tenkaichi 4): a recompiled game's GS stream as it is made, in a dump's packet
+	/// format (PS2Recomp's live ring). The dump file the VM boots holds only the header (the GS state and registers);
+	/// the packets come from `next`, which blocks until one is there and returns false to stop. A ReadFIFO2's data
+	/// (the game reading the GS back) goes to `readback`. Set before the VM boots; no frame limiter (the game paces).
+	struct LivePacket
+	{
+		u8 type;
+		u8 path;
+		const u8* data;
+		u32 length;
+	};
+	using LiveNext = bool (*)(LivePacket* out);
+	using LiveReadback = void (*)(const u8* data, u32 bytes);
+	void SetLive(LiveNext next, LiveReadback readback);
+	bool IsLive();
 } // namespace GSDumpReplayer
